def copy_block(content, label="コピー", extra_class=""):
    classes = "cmd-block"
    if extra_class:
        classes += f" {extra_class}"
    return f"""<div class="{esc(classes)}">
            <button class="copy-btn" type="button">{esc(label)}</button>
            <pre><code>{esc(content.strip())}</code></pre>
          </div>"""


def highlighted_copy_block(content, highlights, label="コピー", extra_class=""):
    classes = "cmd-block"
    if extra_class:
        classes += f" {extra_class}"
    rendered = esc(content.strip())
    for item in sorted(set(highlights), key=len, reverse=True):
        escaped_item = esc(item)
        rendered = rendered.replace(escaped_item, f'<span class="code-hl">{escaped_item}</span>')
    return f"""<div class="{esc(classes)}">
            <button class="copy-btn" type="button">{esc(label)}</button>
            <pre><code>{rendered}</code></pre>
          </div>"""


def cmd_block(text):
    commands = []
    for raw_line in text.strip("\n").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        commands.append(line)
    return "\n".join(copy_block(command) for command in commands)


def highlighted_cmd_block(text, highlights):
    commands = []
    for raw_line in text.strip("\n").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        commands.append(line)
    return "\n".join(highlighted_copy_block(command, highlights) for command in commands)


def config_block(text):
    return copy_block(text, label="設定をコピー", extra_class="config-block")


def highlighted_config_block(text, highlights):
    return highlighted_copy_block(text, highlights, label="設定をコピー", extra_class="config-block")


WIZARD_TABS = ["全般", "OS", "システム", "ディスク", "CPU", "メモリ", "ネットワーク", "確認"]


def screenshot_figure(filename, caption, folder="vm-create"):
    version = str(int(time.time()))
    caption_html = f"<figcaption>{esc(caption)}</figcaption>" if caption else ""
    alt = caption or filename
    return f"""<figure class="screenshot-figure">
            <img src="/static/{esc(folder)}/{esc(filename)}?v={esc(version)}" alt="{esc(alt)}" loading="lazy">
            {caption_html}
          </figure>"""


def wizard_figure(active_tab, rows):
    tabs = "".join(
        f'<span class="{"active" if tab == active_tab else ""}">{esc(tab)}</span>'
        for tab in WIZARD_TABS
    )
    row_html = "".join(
        f'<div class="wizard-row"><span>{esc(label)}</span><strong>{value}</strong></div>'
        for label, value in rows
    )
    return f"""<figure class="wizard-shot">
            <div class="wizard-title">作成: 仮想マシン</div>
            <div class="wizard-tabs">{tabs}</div>
            <div class="wizard-body">{row_html}</div>
          </figure>"""


def build_help_context():
    vms = read_tsv(VMS_FILE, ["vmid", "name", "nat_ip"])
    rules = read_tsv(
        RULES_FILE,
        ["id", "vmid", "name", "proto", "external_port", "vm_ip", "vm_port", "comment"],
    )
    used_ips = sort_ips({row["nat_ip"] for row in vms if row.get("nat_ip")})
    used_ports = sorted(
        {row["external_port"] for row in rules if str(row.get("external_port", "")).isdigit()},
        key=lambda value: int(value),
    )
    return {
        "generated_at": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
        "used_ips": used_ips,
        "used_external_ports": used_ports,
    }


def build_fast_status():
    vms = read_tsv(VMS_FILE, ["vmid", "name", "nat_ip"])
    rules = read_tsv(
        RULES_FILE,
        ["id", "vmid", "name", "proto", "external_port", "vm_ip", "vm_port", "comment"],
    )
    vm_rows = []
    for row in vms:
        vm_rows.append(
            {
                **row,
                "type": "missing",
                "registered": True,
                "exists": False,
                "detected_ip": "",
                "ip_check": "unchecked",
                "ip_ok": False,
                "ip_warn": True,
                "qm_status": "CHECK",
                "network": "読み込み中",
                "mem_mb": "",
                "bootdisk_gb": "",
            }
        )

    rule_rows = []
    for row in rules:
        rule_rows.append(
            {
                **row,
                "out": f"{EXT_IF}:{row['external_port']}",
                "dest": f"{row['vm_ip']}:{row['vm_port']}",
                "vm_port_check": "unchecked",
                "vm_port_ok": False,
                "vm_port_warn": True,
                "vm_port_label": "未確認",
                "vm_port_detail": "読み込み中",
                "vm_exists": False,
                "type": "missing",
                "qm_status": "CHECK",
                "active": False,
            }
        )

    used_external_ports = sorted(
        {row["external_port"] for row in rules if str(row.get("external_port", "")).isdigit()},
        key=lambda value: int(value),
    )
    used_ips = sort_ips({row["nat_ip"] for row in vms if row.get("nat_ip")})
    return {
        "generated_at": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
        "config": {
            "data_dir": DATA_DIR,
            "external_interface": EXT_IF,
            "internal_interface": INT_IF,
            "nat_cidr": NAT_CIDR,
            "dnat_chain": DNAT_CHAIN,
            "forward_chain": FWD_CHAIN,
        },
        "vm_rows": sorted(vm_rows, key=numeric_id_key),
        "rule_rows": sorted(rule_rows, key=numeric_id_key),
        "port_rows": [],
        "used_external_ports": used_external_ports,
        "registered_ips": used_ips,
        "detected_ips": [],
        "used_ips": used_ips,
        "available_ips": [],
        "diagnostics": {
            "qm_list_ok": False,
            "pct_list_ok": False,
            "vmbr0": "",
            "vmbr1": "",
            "vmbr0_ip": "",
            "vmbr1_ip": "",
            "ip_forward": "",
            "masquerade_ok": False,
            "pve_portfw_service": "",
            "pve_portfw_web_service": "",
            "dnat_chain_ok": False,
            "forward_chain_ok": False,
            "dnat_rule_count": 0,
            "forward_rule_count": 0,
            "unmanaged_dnat": [],
        },
    }


def render_html(status):
    diag = status["diagnostics"]
    vm_rows = status["vm_rows"]
    rule_rows = status["rule_rows"]
    registered_count = sum(1 for row in vm_rows if row["registered"])
    unregistered_count = sum(1 for row in vm_rows if not row["registered"])
    active_rule_count = sum(1 for row in rule_rows if row["active"])

    vm_body = "\n".join(
        f"""
        <tr>
          <td>{esc(type_label(row['type']))}</td>
          <td>{esc(row['vmid'])}</td>
          <td>{esc(row['name'])}</td>
          <td>{esc(row['nat_ip'] or '-')}</td>
          <td>{esc(row['detected_ip'] or '-')}</td>
          <td>{status_pill(row['ip_check'], row['ip_ok'], row['ip_warn'])}</td>
          <td>{esc(row['network'])}</td>
          <td>{status_pill('registered' if row['registered'] else 'unregistered', row['registered'])}</td>
          <td>{status_pill(row['qm_status'], row['exists'] and row['qm_status'] == 'running')}</td>
          <td>{esc(row['mem_mb'])}</td>
          <td>{esc(row['bootdisk_gb'])}</td>
        </tr>
        """
        for row in vm_rows
    ) or '<tr><td colspan="11" class="empty">VM/CTはありません。</td></tr>'

    rules_body = "\n".join(
        f"""
        <tr>
          <td>{esc(row['id'])}</td>
          <td>{esc(row['proto'])}</td>
          <td><code>{esc(row['out'])}</code></td>
          <td><code>{esc(row['dest'])}</code></td>
          <td>{esc(row['vmid'])}</td>
          <td>{esc(type_label(row['type']))}</td>
          <td>{esc(row['name'])}</td>
          <td>{status_pill('active' if row['active'] else 'missing', row['active'])}</td>
          <td title="{esc(row['vm_port_detail'])}">{status_pill(row['vm_port_label'], row['vm_port_ok'], row['vm_port_warn'])}</td>
          <td>{status_pill(row['qm_status'], row['vm_exists'] and row['qm_status'] == 'running')}</td>
          <td>{esc(row['comment'])}</td>
        </tr>
        """
        for row in rule_rows
    ) or '<tr><td colspan="11" class="empty">ポート転送ルールはありません。</td></tr>'

    used_ips = "".join(f"<li><code>{esc(ip)}</code></li>" for ip in status["used_ips"]) or '<li class="empty">なし</li>'
    used_external_ports = "".join(f"<li><code>{esc(port)}</code></li>" for port in status["used_external_ports"]) or '<li class="empty">なし</li>'
    unmanaged = "".join(f"<li><code>{esc(line)}</code></li>" for line in diag["unmanaged_dnat"]) or '<li class="empty">なし</li>'

    diag_items = [
        ("VM一覧", "qm list", diag["qm_list_ok"]),
        ("コンテナ一覧", "pct list", diag["pct_list_ok"]),
        ("vmbr0", diag["vmbr0"], bool(diag["vmbr0"])),
        ("vmbr1", diag["vmbr1"], bool(diag["vmbr1"])),
        ("IP転送", diag["ip_forward"], diag["ip_forward"] == "1"),
        ("MASQUERADE", f"{NAT_CIDR} -> {EXT_IF}", diag["masquerade_ok"]),
        ("pve-portfw.service", diag["pve_portfw_service"], diag["pve_portfw_service"] == "active"),
        ("pve-portfw-web.service", diag["pve_portfw_web_service"], diag["pve_portfw_web_service"] in {"active", "activating"}),
        ("DNATチェーン", DNAT_CHAIN, diag["dnat_chain_ok"]),
        ("FORWARDチェーン", FWD_CHAIN, diag["forward_chain_ok"]),
    ]
    diag_body = "\n".join(
        f"""
        <tr>
          <td>{esc(name)}</td>
          <td>{esc(value)}</td>
          <td>{status_pill('OK' if ok else 'CHECK', ok)}</td>
        </tr>
        """
        for name, value, ok in diag_items
    )

    return f"""<!doctype html>
