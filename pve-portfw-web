def run(cmd, timeout=5):
    try:
        result = subprocess.run(
            cmd,
            check=False,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
        return {
            "ok": result.returncode == 0,
            "code": result.returncode,
            "stdout": result.stdout.strip(),
            "stderr": result.stderr.strip(),
        }
    except Exception as exc:
        return {"ok": False, "code": -1, "stdout": "", "stderr": str(exc)}


def read_tsv(path, columns):
    rows = []
    try:
        with open(path, "r", encoding="utf-8") as handle:
            for line in handle:
                line = line.rstrip("\n")
                if not line or line.startswith("#"):
                    continue
                parts = line.split("\t")
                parts.extend([""] * (len(columns) - len(parts)))
                rows.append(dict(zip(columns, parts[: len(columns)])))
    except FileNotFoundError:
        pass
    return rows


def qm_list():
    result = run(["qm", "list"])
    rows = {}
    if not result["ok"]:
        return rows, result
    for line in result["stdout"].splitlines()[1:]:
        parts = line.split()
        if len(parts) < 5:
            continue
        vmid, name, status, mem, bootdisk = parts[:5]
        pid = parts[5] if len(parts) > 5 else ""
        rows[vmid] = {
            "type": "vm",
            "vmid": vmid,
            "name": name,
            "status": status,
            "mem_mb": mem,
            "bootdisk_gb": bootdisk,
            "pid": pid,
        }
    for vmid, row in rows.items():
        bridges = guest_bridges("vm", vmid)
        row["bridges"] = bridges
        row["network"] = network_label(bridges)
    return rows, result


def pct_list():
    result = run(["pct", "list"])
    rows = {}
    if not result["ok"]:
        return rows, result
    for line in result["stdout"].splitlines()[1:]:
        parts = line.split()
        if len(parts) < 2:
            continue
        vmid = parts[0]
        status = parts[1]
        name = parts[-1] if len(parts) >= 3 else f"ct-{vmid}"
        rows[vmid] = {
            "type": "ct",
            "vmid": vmid,
            "name": name,
            "status": status,
            "mem_mb": "",
            "bootdisk_gb": "",
            "pid": "",
        }
    for vmid, row in rows.items():
        bridges = guest_bridges("ct", vmid)
        row["bridges"] = bridges
        row["network"] = network_label(bridges)
    return rows, result


def guest_config(kind, vmid):
    command = "pct" if kind == "ct" else "qm"
    key = (command, str(vmid))
    now = time.monotonic()
    with _CONFIG_LOCK:
        cached = _CONFIG_CACHE.get(key)
        if cached and now - cached["time"] < CONFIG_CACHE_SECONDS:
            return cached["result"]

    result = run([command, "config", str(vmid)])
    with _CONFIG_LOCK:
        _CONFIG_CACHE[key] = {"time": now, "result": result}
    return result


def guest_bridges(kind, vmid):
    result = guest_config(kind, vmid)
    bridges = []
    if not result["ok"]:
        return bridges
    for line in result["stdout"].splitlines():
        if not line.startswith("net"):
            continue
        _, _, config = line.partition(":")
        for part in config.split(","):
            part = part.strip()
            if part.startswith("bridge="):
                bridge = part.split("=", 1)[1]
                if bridge not in bridges:
                    bridges.append(bridge)
    return bridges


def network_label(bridges):
    if INT_IF in bridges:
        return f"{','.join(bridges)} NAT"
    if EXT_IF in bridges:
        return f"{','.join(bridges)} ブリッジ"
    if bridges:
        return ",".join(bridges)
    return "なし"


def probe_nat_network():
    global _LAST_SCAN_AT
    with _SCAN_LOCK:
        now = time.monotonic()
        if now - _LAST_SCAN_AT < SCAN_CACHE_SECONDS:
            return
        _LAST_SCAN_AT = now

    gateway = first_ip_from_brief(run(["ip", "-br", "-4", "addr", "show", INT_IF])["stdout"]).split("/")[0]
    try:
        network = ipaddress.ip_network(NAT_CIDR, strict=False)
    except Exception:
        return

    targets = [str(ip) for ip in network.hosts() if str(ip) != gateway]

    def ping_one(ip_text):
        subprocess.run(
            ["ping", "-n", "-c", "1", "-W", "1", ip_text],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2,
        )

    with concurrent.futures.ThreadPoolExecutor(max_workers=SCAN_WORKERS) as pool:
        list(pool.map(ping_one, targets))


def detected_ips_by_mac():
    result = run(["ip", "neigh", "show", "dev", INT_IF])
    mapping = {}
    if not result["ok"]:
        return mapping
    for line in result["stdout"].splitlines():
        parts = line.split()
        if not parts or "." not in parts[0] or "lladdr" not in parts:
            continue
        idx = parts.index("lladdr")
        if idx + 1 >= len(parts):
            continue
        ip = parts[0]
        mac = parts[idx + 1].lower()
        mapping.setdefault(mac, set()).add(ip)
    return mapping


def guest_macs(kind, vmid):
    result = guest_config(kind, vmid)
    macs = []
    if not result["ok"]:
        return macs
    import re

    for mac in re.findall(r"[0-9A-Fa-f]{2}(?::[0-9A-Fa-f]{2}){5}", result["stdout"]):
        lowered = mac.lower()
        if lowered not in macs:
            macs.append(lowered)
    return macs


def sort_ips(values):
    def key(value):
        try:
            return (0, ipaddress.ip_address(value))
        except Exception:
            return (1, value)

    return sorted(values, key=key)


def numeric_id_key(row):
    value = row.get("vmid") or row.get("id") or "0"
    try:
        return (0, int(value))
    except Exception:
        return (1, str(value))


def detected_ips_for_row(row, mac_to_ips):
    detected = set()
    for mac in guest_macs(row["type"], row["vmid"]):
        detected.update(mac_to_ips.get(mac, set()))
    return sort_ips(detected)


def ip_check_state(registered_ip, detected_ips, exists):
    if not exists:
        return "missing", False, False
    if registered_ip and registered_ip in detected_ips:
        return "ok", True, False
    if registered_ip and detected_ips:
        return "mismatch", False, False
    if registered_ip:
        return "no-ip", False, True
    if detected_ips:
        return "detected", False, True
    return "unregistered", False, True


def first_ip_from_brief(output):
    parts = output.split()
    for item in parts:
        if "/" in item and not item.startswith("fe80:"):
            return item
    return ""


def iptables_chain(table, chain):
    cmd = ["iptables", "-t", table, "-S", chain] if table else ["iptables", "-S", chain]
    result = run(cmd)
    if result["ok"]:
        return result["stdout"].splitlines()
    return []


def parse_port_from_local_address(value):
    if not value or ":" not in value:
        return ""
    port = value.rsplit(":", 1)[1]
    return port if port.isdigit() else ""


def host_from_local_address(value, port):
    if not value:
        return ""
    if value.startswith("[") and f"]:{port}" in value:
        return value[1 : value.rfind("]:")]
    suffix = f":{port}"
    if value.endswith(suffix):
        return value[: -len(suffix)]
    return ""


def local_address_conflicts(local_addr, port, ext_ip):
    host = host_from_local_address(local_addr, port)
    return host in {"*", "0.0.0.0", "::"} or bool(ext_ip and host == ext_ip)


def listening_port_rows(ext_ip):
    rows = []
    for proto, cmd in (
        ("tcp", ["ss", "-H", "-lntp"]),
        ("udp", ["ss", "-H", "-lnup"]),
    ):
        result = run(cmd)
        if not result["ok"]:
            continue
        for line in result["stdout"].splitlines():
            parts = line.split(None, 5)
            if len(parts) < 4:
                continue
            local_addr = parts[3]
            port = parse_port_from_local_address(local_addr)
            if not port:
                continue
            if not local_address_conflicts(local_addr, port, ext_ip):
                continue
            detail = line
            rows.append(
                {
                    "proto": proto,
                    "port": port,
                    "source": "Proxmoxサービス",
                    "detail": detail,
                }
            )
    return rows


def unmanaged_dnat_port_rows(lines):
    rows = []
    for line in lines:
        parts = line.split()
        proto = "-"
        port = ""
        for index, part in enumerate(parts[:-1]):
            if part == "-p":
                proto = parts[index + 1]
            elif part == "--dport":
                port = parts[index + 1]
        if not port:
            continue
        rows.append(
            {
                "proto": proto,
                "port": port,
                "source": "管理外DNAT",
                "detail": line,
            }
        )
    return rows


def sort_port_rows(rows):
    def key(row):
        try:
            port = int(row["port"])
        except Exception:
            port = 999999
        return (port, row.get("proto", ""), row.get("source", ""))

    return sorted(rows, key=key)


def tcp_port_open(ip, port, timeout=VM_PORT_TIMEOUT):
    try:
        with socket.create_connection((ip, int(port)), timeout=timeout):
            return True
    except Exception:
        return False


def vm_port_check(proto, ip, port):
    if proto != "tcp":
        return {
            "status": "unchecked",
            "ok": False,
            "warn": True,
            "label": "未確認",
            "detail": "UDPは接続確認しません",
        }
    if tcp_port_open(ip, port):
        return {
            "status": "open",
            "ok": True,
            "warn": False,
            "label": "待受あり",
            "detail": f"{ip}:{port} に接続できました",
        }
    return {
        "status": "closed",
        "ok": False,
        "warn": True,
        "label": "待受なし",
        "detail": f"{ip}:{port} に接続できません",
    }


def build_status():
    vms = read_tsv(VMS_FILE, ["vmid", "name", "nat_ip"])
    rules = read_tsv(
        RULES_FILE,
        ["id", "vmid", "name", "proto", "external_port", "vm_ip", "vm_port", "comment"],
    )
    qm_rows, qm_result = qm_list()
    ct_rows, pct_result = pct_list()
    guest_rows = {**qm_rows, **ct_rows}
    registered_by_vmid = {row["vmid"]: row for row in vms}
    registered_ips = {row["nat_ip"] for row in vms if row.get("nat_ip")}
    if WEB_PROBE_ON_REQUEST:
        probe_nat_network()
    mac_to_ips = detected_ips_by_mac()
    detected_ip_set = set().union(*mac_to_ips.values()) if mac_to_ips else set()
    occupied_ips = registered_ips | detected_ip_set

    vm_rows = []
    for row in vms:
        q = guest_rows.get(row["vmid"])
        detected_ips = detected_ips_for_row(q, mac_to_ips) if q else []
        ip_state, ip_ok, ip_warn = ip_check_state(row.get("nat_ip", ""), detected_ips, q is not None)
        vm_rows.append(
            {
                **row,
                "type": q["type"] if q else "missing",
                "registered": True,
                "exists": q is not None,
                "detected_ip": ", ".join(detected_ips),
                "ip_check": ip_state,
                "ip_ok": ip_ok,
                "ip_warn": ip_warn,
                "qm_status": q["status"] if q else "missing",
                "network": q["network"] if q else "不明",
                "mem_mb": q["mem_mb"] if q else "",
                "bootdisk_gb": q["bootdisk_gb"] if q else "",
            }
        )

    for vmid, q in sorted(guest_rows.items(), key=lambda item: int(item[0])):
        if vmid in registered_by_vmid:
            continue
        detected_ips = detected_ips_for_row(q, mac_to_ips)
        ip_state, ip_ok, ip_warn = ip_check_state("", detected_ips, True)
        vm_rows.append(
            {
                "type": q["type"],
                "vmid": vmid,
                "name": q["name"],
                "nat_ip": "",
                "registered": False,
                "exists": True,
                "detected_ip": ", ".join(detected_ips),
                "ip_check": ip_state,
                "ip_ok": ip_ok,
                "ip_warn": ip_warn,
                "qm_status": q["status"],
                "network": q["network"],
                "mem_mb": q["mem_mb"],
                "bootdisk_gb": q["bootdisk_gb"],
            }
        )

    dnat_lines = iptables_chain("nat", DNAT_CHAIN)
    fwd_lines = iptables_chain("", FWD_CHAIN)
    rule_rows = []
    for row in rules:
        dest = f"{row['vm_ip']}:{row['vm_port']}"
        needle = f"--dport {row['external_port']} -j DNAT --to-destination {dest}"
        active = any(needle in line for line in dnat_lines)
        q = guest_rows.get(row["vmid"])
        port_check = vm_port_check(row["proto"], row["vm_ip"], row["vm_port"])
        rule_rows.append(
            {
                **row,
                "out": f"{EXT_IF}:{row['external_port']}",
                "dest": dest,
                "vm_port_check": port_check["status"],
                "vm_port_ok": port_check["ok"],
                "vm_port_warn": port_check["warn"],
                "vm_port_label": port_check["label"],
                "vm_port_detail": port_check["detail"],
                "vm_exists": q is not None,
                "type": q["type"] if q else "missing",
                "qm_status": q["status"] if q else "missing",
                "active": active,
            }
        )
    vm_rows.sort(key=numeric_id_key)
    rule_rows.sort(key=numeric_id_key)

    available_ips = []
    try:
        network = ipaddress.ip_network(NAT_CIDR, strict=False)
        hosts = list(network.hosts())
        start = ipaddress.ip_address("10.10.10.10")
        for ip in hosts:
            if ip == ipaddress.ip_address("10.10.10.1"):
                continue
            if ip.version == 4 and ip < start and str(network.network_address) == "10.10.10.0":
                continue
            ip_text = str(ip)
            if ip_text not in occupied_ips:
                available_ips.append(ip_text)
            if len(available_ips) >= 20:
                break
    except Exception:
        pass

    vmbr0 = run(["ip", "-br", "addr", "show", EXT_IF])
    vmbr1 = run(["ip", "-br", "addr", "show", INT_IF])
    ip_forward = run(["sysctl", "-n", "net.ipv4.ip_forward"])
    masq = run(["iptables", "-t", "nat", "-C", "POSTROUTING", "-s", NAT_CIDR, "-o", EXT_IF, "-j", "MASQUERADE"])
    service = run(["systemctl", "is-active", "pve-portfw.service"])
    web_service = run(["systemctl", "is-active", "pve-portfw-web.service"])
    dnat_exists = run(["iptables", "-t", "nat", "-L", DNAT_CHAIN, "-n"])
    fwd_exists = run(["iptables", "-L", FWD_CHAIN, "-n"])
    unmanaged = run(["bash", "-lc", f"iptables -t nat -S PREROUTING | grep DNAT | grep -v {DNAT_CHAIN!r} || true"])
    unmanaged_lines = unmanaged["stdout"].splitlines() if unmanaged["stdout"] else []

    port_rows = []
    for row in rules:
        port_rows.append(
            {
                "proto": row["proto"],
                "port": row["external_port"],
                "source": "pve-portfw",
                "detail": f"{EXT_IF}:{row['external_port']} -> {row['vm_ip']}:{row['vm_port']} ({row['name']})",
            }
        )
    ext_ip = first_ip_from_brief(vmbr0["stdout"]).split("/")[0]
    port_rows.extend(listening_port_rows(ext_ip))
    port_rows.extend(unmanaged_dnat_port_rows(unmanaged_lines))
    port_rows = sort_port_rows(port_rows)
    used_external_ports = sorted(
        {row["port"] for row in port_rows if str(row.get("port", "")).isdigit()},
        key=lambda value: int(value),
    )

    return {
        "generated_at": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
        "config": {
            "data_dir": DATA_DIR,
            "external_interface": EXT_IF,
            "internal_interface": INT_IF,
            "nat_cidr": NAT_CIDR,
            "dnat_chain": DNAT_CHAIN,
            "forward_chain": FWD_CHAIN,
        },
        "vm_rows": vm_rows,
        "rule_rows": rule_rows,
        "port_rows": port_rows,
        "used_external_ports": used_external_ports,
        "registered_ips": sort_ips(registered_ips),
        "detected_ips": sort_ips(detected_ip_set),
        "used_ips": sort_ips(occupied_ips),
        "available_ips": available_ips,
        "diagnostics": {
            "qm_list_ok": qm_result["ok"],
            "pct_list_ok": pct_result["ok"],
            "vmbr0": vmbr0["stdout"],
            "vmbr1": vmbr1["stdout"],
            "vmbr0_ip": first_ip_from_brief(vmbr0["stdout"]),
            "vmbr1_ip": first_ip_from_brief(vmbr1["stdout"]),
            "ip_forward": ip_forward["stdout"],
            "masquerade_ok": masq["ok"],
            "pve_portfw_service": service["stdout"],
            "pve_portfw_web_service": web_service["stdout"],
            "dnat_chain_ok": dnat_exists["ok"],
            "forward_chain_ok": fwd_exists["ok"],
            "dnat_rule_count": len([line for line in dnat_lines if line.startswith("-A ")]),
            "forward_rule_count": len([line for line in fwd_lines if line.startswith("-A ")]),
            "unmanaged_dnat": unmanaged_lines,
        },
    }


def refresh_status_cache():
    global _STATUS_CACHE, _STATUS_ERROR
    try:
        status = build_status()
    except Exception as exc:
        with _STATUS_LOCK:
            _STATUS_ERROR = str(exc)
        return None

    with _STATUS_LOCK:
        _STATUS_CACHE = status
        _STATUS_ERROR = ""
    return status


def cached_status():
    with _STATUS_LOCK:
        return _STATUS_CACHE


def status_for_response():
    status = cached_status()
    if status is not None:
        return status
    status = refresh_status_cache()
    return status if status is not None else build_fast_status()


def status_refresher():
    while True:
        refresh_status_cache()
        time.sleep(STATUS_REFRESH_SECONDS)


def start_status_refresher():
    thread = threading.Thread(target=status_refresher, name="status-refresher", daemon=True)
    thread.start()


