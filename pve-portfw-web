  </main>
  <script>
    const labels = {{
      ok: "一致",
      mismatch: "不一致",
      "no-ip": "未検出",
      detected: "検出済み",
      unregistered: "未登録",
      registered: "登録済み",
      missing: "不明",
      active: "有効",
      open: "待受あり",
      closed: "待受なし",
      unchecked: "未確認",
      running: "実行中",
      stopped: "停止中",
      OK: "正常",
      CHECK: "確認"
    }};

    function esc(value) {{
      return String(value ?? "").replace(/[&<>"']/g, char => ({{
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
      }}[char]));
    }}

    function typeLabel(value) {{
      return {{ vm: "VM", ct: "CT", missing: "不明" }}[value] || value || "";
    }}

    function pill(label, good, warning = false) {{
      const cls = good ? "ok" : warning ? "warn" : "bad";
      return `<span class="pill ${{cls}}">${{esc(labels[label] || label)}}</span>`;
    }}

    function code(value) {{
      return `<code>${{esc(value)}}</code>`;
    }}

    function listItems(values) {{
      if (!values || values.length === 0) return '<li class="empty">なし</li>';
      return values.map(value => `<li>${{code(value)}}</li>`).join("");
    }}

    function renderStatus(status) {{
      const vmRows = status.vm_rows || [];
      const ruleRows = status.rule_rows || [];
      document.getElementById("registered-count").textContent = vmRows.filter(row => row.registered).length;
      document.getElementById("unregistered-count").textContent = vmRows.filter(row => !row.registered).length;
      document.getElementById("rule-count").textContent = ruleRows.length;
      document.getElementById("active-rule-count").textContent = ruleRows.filter(row => row.active).length;
      document.getElementById("generated-at").textContent = status.generated_at || "";

      document.getElementById("vm-body").innerHTML = vmRows.length ? vmRows.map(row => `
        <tr>
          <td>${{esc(typeLabel(row.type))}}</td>
          <td>${{esc(row.vmid)}}</td>
          <td>${{esc(row.name)}}</td>
          <td>${{esc(row.nat_ip || "-")}}</td>
          <td>${{esc(row.detected_ip || "-")}}</td>
          <td>${{pill(row.ip_check, row.ip_ok, row.ip_warn)}}</td>
          <td>${{esc(row.network)}}</td>
          <td>${{pill(row.registered ? "registered" : "unregistered", row.registered)}}</td>
          <td>${{pill(row.qm_status, row.exists && row.qm_status === "running")}}</td>
          <td>${{esc(row.mem_mb)}}</td>
          <td>${{esc(row.bootdisk_gb)}}</td>
        </tr>
      `).join("") : '<tr><td colspan="11" class="empty">VM/CTはありません。</td></tr>';

      document.getElementById("rules-body").innerHTML = ruleRows.length ? ruleRows.map(row => `
        <tr>
          <td>${{esc(row.id)}}</td>
          <td>${{esc(row.proto)}}</td>
          <td>${{code(row.out)}}</td>
          <td>${{code(row.dest)}}</td>
          <td>${{esc(row.vmid)}}</td>
          <td>${{esc(typeLabel(row.type))}}</td>
          <td>${{esc(row.name)}}</td>
          <td>${{pill(row.active ? "active" : "missing", row.active)}}</td>
          <td title="${{esc(row.vm_port_detail)}}">${{pill(row.vm_port_label, row.vm_port_ok, row.vm_port_warn)}}</td>
          <td>${{pill(row.qm_status, row.vm_exists && row.qm_status === "running")}}</td>
          <td>${{esc(row.comment)}}</td>
        </tr>
      `).join("") : '<tr><td colspan="11" class="empty">ポート転送ルールはありません。</td></tr>';

      document.getElementById("used-external-ports").innerHTML = listItems(status.used_external_ports);
      document.getElementById("used-ips").innerHTML = listItems(status.used_ips);

      const diag = status.diagnostics || {{}};
      const cfg = status.config || {{}};
      const diagItems = [
        ["VM一覧", "qm list", diag.qm_list_ok],
        ["コンテナ一覧", "pct list", diag.pct_list_ok],
        ["vmbr0", diag.vmbr0 || "", Boolean(diag.vmbr0)],
        ["vmbr1", diag.vmbr1 || "", Boolean(diag.vmbr1)],
        ["IP転送", diag.ip_forward || "", diag.ip_forward === "1"],
        ["MASQUERADE", `${{cfg.nat_cidr || ""}} -> ${{cfg.external_interface || ""}}`, diag.masquerade_ok],
        ["pve-portfw.service", diag.pve_portfw_service || "", diag.pve_portfw_service === "active"],
        ["pve-portfw-web.service", diag.pve_portfw_web_service || "", ["active", "activating"].includes(diag.pve_portfw_web_service)],
        ["DNATチェーン", cfg.dnat_chain || "", diag.dnat_chain_ok],
        ["FORWARDチェーン", cfg.forward_chain || "", diag.forward_chain_ok]
      ];
      document.getElementById("diag-body").innerHTML = diagItems.map(([name, value, ok]) => `
        <tr>
          <td>${{esc(name)}}</td>
          <td>${{esc(value)}}</td>
          <td>${{pill(ok ? "OK" : "CHECK", ok)}}</td>
        </tr>
      `).join("");

      const unmanaged = diag.unmanaged_dnat || [];
      document.getElementById("unmanaged-dnat").innerHTML = unmanaged.length
        ? unmanaged.map(line => `<li>${{code(line)}}</li>`).join("")
        : '<li class="empty">なし</li>';
    }}

    function connectEvents() {{
      const live = document.getElementById("live-status");
      if (!window.EventSource) {{
        live.textContent = "通常更新";
        setInterval(() => fetch("/api/status").then(res => res.json()).then(renderStatus).catch(() => {{
          live.textContent = "更新失敗";
        }}), 5000);
        return;
      }}
      const events = new EventSource("/events");
      events.onopen = () => {{ live.textContent = "接続中"; }};
      events.onmessage = event => {{
        live.textContent = "更新中";
        renderStatus(JSON.parse(event.data));
      }};
      events.onerror = () => {{ live.textContent = "再接続中"; }};
    }}

    connectEvents();
  </script>
</body>
</html>
"""


